<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Market Dispatch · {{ page_date }}{% if is_today %}（今日）{% elif is_archived %}（归档）{% endif %}</title>
<style>
  :root {
    --bg: #F6F1E9;
    --paper: #FFFDF9;
    --tint: #EFE8DC;
    --tint-hover: #E7DEC9;
    --ink: #1B1917;
    --ink-2: #44403C;
    --ink-3: #78716C;
    --rule: #DFD7C8;
    --rule-strong: #1B1917;
    --accent: #990F3D;
    --accent-soft: #F9EBF0;
    --gold: #9A5B06;
    --gold-bg: #FCF6E8;
    --gold-border: #D9A441;
    --ok: #166534;
    --ok-bg: #EAF5EE;
    --err: #B91C1C;
    --err-bg: #FDECEC;
    --bbg-bg: #141414; --bbg-fg: #FFFFFF;
    --rtr-bg: #C74F00; --rtr-fg: #FFFFFF;
    --wsj-bg: #0A5894; --wsj-fg: #FFFFFF;
    --serif: Georgia, "Songti SC", "STSong", "Noto Serif CJK SC", "Times New Roman", serif;
    --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", sans-serif;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  }

  [data-theme="dark"] {
    --bg: #121316;
    --paper: #191B20;
    --tint: #23262E;
    --tint-hover: #2C303A;
    --ink: #EDE8DF;
    --ink-2: #BEB7AC;
    --ink-3: #857F76;
    --rule: #2D313B;
    --rule-strong: #C9C0AE;
    --accent: #E26B8D;
    --accent-soft: #2D1D24;
    --gold: #E3AA4F;
    --gold-bg: #241E14;
    --gold-border: #8B6523;
    --ok: #4ADE80;
    --ok-bg: #14281D;
    --err: #F87171;
    --err-bg: #2D1719;
    --bbg-bg: #363A45; --bbg-fg: #F5F5F5;
    --rtr-bg: #C74F00; --rtr-fg: #FFFFFF;
    --wsj-bg: #1B6FB0; --wsj-fg: #FFFFFF;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background .2s ease, color .2s ease;
  }

  .container { max-width: 1060px; margin: 0 auto; padding: 0 20px 48px; }

  /* ===== Top Edition Bar ===== */
  .topbar { border-bottom: 1px solid var(--rule); background: var(--paper); transition: background .2s ease; }
  .topbar-inner {
    max-width: 1060px; margin: 0 auto; padding: 8px 20px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap; font-size: 13px;
  }
  .edition-tabs { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .edition-label { color: var(--ink-3); font-size: 12px; margin-right: 6px; letter-spacing: .04em; }
  .ed-tab {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 11px;
    border-radius: 3px; text-decoration: none; color: var(--ink-2);
    border: 1px solid transparent; font-family: var(--mono);
    font-size: 12.5px; font-variant-numeric: tabular-nums; transition: all .15s;
  }
  .ed-tab:hover { background: var(--tint); color: var(--ink); }
  .ed-tab.active { background: var(--ink); color: var(--paper); font-weight: 600; }
  .ed-tab .cnt { font-size: 11px; opacity: .72; }
  .live-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #22C55E;
    display: inline-block; box-shadow: 0 0 0 2px rgba(34,197,94,.25);
  }
  .topbar-right { display: flex; align-items: center; gap: 12px; }
  .archive-link {
    color: var(--accent); text-decoration: none; font-weight: 600;
    font-size: 13px; padding: 4px 8px; border-radius: 3px;
  }
  .archive-link:hover { background: var(--accent-soft); }
  .theme-btn {
    background: transparent; border: 1px solid var(--rule); color: var(--ink-2);
    padding: 4px 10px; border-radius: 3px; font-size: 12.5px; cursor: pointer; font-family: var(--sans);
  }
  .theme-btn:hover { background: var(--tint); color: var(--ink); }

  /* ===== History / Archive Banner ===== */
  .history-banner {
    margin-top: 16px; padding: 9px 16px; background: var(--tint); border: 1px solid var(--rule);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    font-size: 12.5px; color: var(--ink-2);
  }
  .history-banner a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .history-banner a:hover { text-decoration: underline; }

  /* ===== Broadsheet Masthead ===== */
  .masthead { padding: 26px 0 0; text-align: center; }
  .masthead-kicker {
    font-family: var(--mono); font-size: 11px; letter-spacing: .24em;
    text-transform: uppercase; color: var(--ink-3); margin-bottom: 6px;
  }
  .masthead h1 {
    font-family: var(--serif); font-size: clamp(32px, 4.4vw, 46px);
    font-weight: 700; letter-spacing: .02em; color: var(--ink); line-height: 1.12;
  }
  .dateline {
    margin-top: 16px; border-top: 2px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong);
    padding: 8px 4px; display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px; font-size: 12.5px; color: var(--ink-2);
  }
  .dateline-left, .dateline-right { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .dateline b { color: var(--ink); font-weight: 600; }
  .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .batch-toggle {
    border: 1px solid transparent; padding: 2px 9px; border-radius: 3px;
    font-size: 12px; cursor: pointer; font-family: var(--sans);
    display: inline-flex; align-items: center; gap: 5px;
  }
  .batch-toggle.ok { background: var(--ok-bg); color: var(--ok); border-color: rgba(22,101,52,.22); }
  .batch-toggle.bad { background: var(--err-bg); color: var(--err); border-color: rgba(185,28,28,.22); }
  .batch-toggle:hover { filter: brightness(.96); }
  .batch-drawer {
    display: none; background: var(--paper); border-bottom: 1px solid var(--rule);
    padding: 12px 16px; text-align: left; font-size: 12px; color: var(--ink-2);
  }
  .batch-drawer.open { display: block; }
  .batch-grid {
    display: flex; flex-wrap: wrap; gap: 6px 10px; margin-top: 6px;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
  }
  .b-chip { padding: 2px 7px; border-radius: 2px; background: var(--ok-bg); color: var(--ok); }
  .b-chip.bad { background: var(--err-bg); color: var(--err); font-weight: 600; }

  /* ===== Front-Page Lead Briefing ===== */
  .lead-section {
    margin-top: 22px; background: var(--paper); border: 1px solid var(--rule);
    border-top: 3px solid var(--accent); padding: 16px 20px 18px;
  }
  .lead-header {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--rule); margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .lead-header h2 {
    font-family: var(--serif); font-size: 16px; color: var(--accent);
    letter-spacing: .04em; display: flex; align-items: center; gap: 6px;
  }
  .lead-header .sub { font-size: 12px; color: var(--ink-3); }
  .lead-grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 20px;
  }
  .lead-card {
    padding: 10px 12px; border: 1px solid var(--rule); background: var(--bg);
    display: flex; flex-direction: column; justify-content: space-between; gap: 8px;
  }
  .lead-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 11.5px; }
  .lead-cat { color: var(--ink-3); font-weight: 600; }
  .lead-reason {
    color: var(--gold); background: var(--gold-bg); border: 1px solid var(--gold-border);
    padding: 0 6px; border-radius: 2px; font-size: 11px;
  }
  .lead-title-zh {
    display: block; font-size: 15px; font-weight: 700; line-height: 1.42;
    color: var(--ink); text-decoration: none;
  }
  .lead-title-zh:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .lead-title-en {
    font-family: var(--serif); font-size: 12.5px; line-height: 1.38;
    color: var(--ink-3); margin-top: 4px;
  }
  .lead-foot {
    display: flex; align-items: center; justify-content: space-between; font-size: 11.5px;
    color: var(--ink-3); padding-top: 6px; border-top: 1px dashed var(--rule);
    font-family: var(--mono); font-variant-numeric: tabular-nums;
  }
  .lead-foot a { color: var(--accent); text-decoration: none; font-family: var(--sans); font-weight: 500; }
  .lead-foot a:hover { text-decoration: underline; }

  /* ===== Sticky Reading Controls ===== */
  .controls-wrap {
    position: sticky; top: 0; z-index: 40; margin-top: 20px;
    background: var(--bg); padding: 10px 0 8px; border-bottom: 1px solid var(--rule);
  }
  .cat-bar {
    display: flex; align-items: center; gap: 4px; overflow-x: auto;
    padding-bottom: 8px; border-bottom: 1px solid var(--rule); scrollbar-width: none;
  }
  .cat-bar::-webkit-scrollbar { display: none; }
  .cat-btn {
    border: none; background: transparent; color: var(--ink-2); font-family: var(--sans);
    font-size: 13.5px; font-weight: 600; padding: 5px 11px; border-radius: 3px;
    cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px;
    transition: all .15s;
  }
  .cat-btn:hover { background: var(--tint); color: var(--ink); }
  .cat-btn.active { background: var(--ink); color: var(--paper); }
  .cat-btn .n { font-family: var(--mono); font-size: 11.5px; font-weight: 500; opacity: .72; }

  .filter-bar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px; padding-top: 8px; font-size: 12.5px;
  }
  .filter-group { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .fg-label { color: var(--ink-3); font-size: 12px; margin-right: 2px; }
  .pill-btn {
    background: var(--paper); border: 1px solid var(--rule); color: var(--ink-2);
    padding: 3px 10px; border-radius: 3px; font-size: 12.5px; cursor: pointer;
    font-family: var(--sans); display: inline-flex; align-items: center; gap: 5px; transition: all .15s;
  }
  .pill-btn:hover { border-color: var(--ink-3); color: var(--ink); }
  .pill-btn.active { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .pill-btn.star-only.active { background: var(--gold); border-color: var(--gold); color: #fff; }
  .src-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .dot-bbg { background: var(--bbg-bg); }
  .dot-rtr { background: var(--rtr-bg); }
  .dot-wsj { background: var(--wsj-bg); }
  [data-theme="dark"] .dot-bbg { background: #E5E7EB; }

  .seg-switch {
    display: inline-flex; border: 1px solid var(--rule); border-radius: 3px;
    overflow: hidden; background: var(--paper);
  }
  .seg-switch button {
    border: none; background: transparent; color: var(--ink-2);
    padding: 3px 9px; font-size: 12px; cursor: pointer; font-family: var(--sans);
  }
  .seg-switch button.active { background: var(--ink); color: var(--paper); font-weight: 600; }
  .status-right { display: flex; align-items: center; gap: 10px; color: var(--ink-3); font-size: 12px; font-family: var(--mono); }
  .reset-link {
    background: none; border: none; color: var(--accent); cursor: pointer;
    font-size: 12px; font-family: var(--sans); text-decoration: underline; display: none;
  }
  .reset-link.show { display: inline; }

  /* ===== Editorial Sections ===== */
  .sections-list { margin-top: 22px; display: flex; flex-direction: column; gap: 28px; }
  section.cat-sec { background: var(--paper); border: 1px solid var(--rule); border-top: 2.5px solid var(--rule-strong); }
  .sec-head {
    padding: 12px 22px; border-bottom: 1px solid var(--rule);
    display: flex; align-items: center; justify-content: space-between;
    cursor: pointer; user-select: none;
  }
  .sec-head:hover { background: var(--tint); }
  .sec-title-wrap { display: flex; align-items: baseline; gap: 10px; }
  .sec-head h3 { font-family: var(--serif); font-size: 18px; font-weight: 700; color: var(--ink); letter-spacing: .03em; }
  .sec-en { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .sec-meta { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--ink-3); font-family: var(--mono); }
  .sec-body.collapsed { display: none; }

  /* ===== Article Row ===== */
  article.item { padding: 15px 22px; border-bottom: 1px solid var(--rule); transition: background .12s; }
  article.item:last-child { border-bottom: none; }
  article.item:hover { background: rgba(153, 15, 61, .02); }
  article.item.star { background: var(--gold-bg); border-left: 3.5px solid var(--gold-border); padding-left: 18.5px; }
  article.item:target { outline: 2px solid var(--accent); outline-offset: -2px; }

  .item-meta {
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; flex-wrap: wrap; margin-bottom: 6px;
  }
  .meta-left { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
  .badge {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .03em;
    padding: 1px 7px; border-radius: 2px; line-height: 1.5;
  }
  .badge.bbg { background: var(--bbg-bg); color: var(--bbg-fg); }
  .badge.rtr { background: var(--rtr-bg); color: var(--rtr-fg); }
  .badge.wsj { background: var(--wsj-bg); color: var(--wsj-fg); }

  .star-pill { font-size: 11.5px; font-weight: 700; color: var(--gold); }
  .why-pill { font-size: 11px; color: var(--gold); border: 1px solid var(--gold-border); padding: 0 6px; border-radius: 2px; }
  .tag-warn { font-size: 11px; background: var(--err-bg); color: var(--err); padding: 0 6px; border-radius: 2px; font-weight: 600; }
  .tag-cross { font-size: 11px; background: var(--accent-soft); color: var(--accent); padding: 0 6px; border-radius: 2px; font-weight: 600; }
  .tag-muted { font-size: 11px; background: var(--tint); color: var(--ink-3); padding: 0 6px; border-radius: 2px; }

  .time-pair {
    display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono);
    font-size: 11.5px; font-variant-numeric: tabular-nums; color: var(--ink-3); white-space: nowrap;
  }
  .time-pair .t-pub { color: var(--ink-2); }
  .time-pair .t-pub b { color: var(--ink); font-weight: 600; }
  .time-pair .t-sep { opacity: .45; }
  .time-pair .t-crt { color: var(--ink-3); }

  .title-zh {
    display: inline-block; font-size: 16.5px; font-weight: 700; line-height: 1.42;
    color: var(--ink); text-decoration: none;
  }
  .title-zh:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .title-zh .ext { font-size: 12.5px; color: var(--ink-3); margin-left: 4px; font-weight: 400; }
  .title-en {
    display: block; margin-top: 3px; font-family: var(--serif); font-size: 13.5px;
    line-height: 1.4; color: var(--ink-3); text-decoration: none;
  }
  .title-en:hover { color: var(--ink); text-decoration: underline; }
  .item.untranslated .title-en { font-size: 16px; font-weight: 600; color: var(--ink); margin-top: 0; }

  .sum-zh { margin-top: 6px; font-size: 14px; line-height: 1.65; color: var(--ink-2); max-width: 82ch; }
  details.en-sum { margin-top: 6px; max-width: 82ch; }
  details.en-sum summary {
    font-size: 12px; color: var(--ink-3); cursor: pointer; user-select: none;
    list-style: none; display: inline-flex; align-items: center; gap: 4px;
  }
  details.en-sum summary::-webkit-details-marker { display: none; }
  details.en-sum summary::before { content: "▸"; font-size: 11px; transition: transform .15s; }
  details.en-sum[open] summary::before { transform: rotate(90deg); }
  details.en-sum summary:hover { color: var(--ink); }
  details.en-sum p {
    margin-top: 5px; padding-left: 10px; border-left: 2px solid var(--rule);
    font-family: var(--serif); font-size: 13px; line-height: 1.55; color: var(--ink-3);
  }

  body.zh-only .title-en,
  body.zh-only .lead-title-en { display: none; }
  body.zh-only .item.untranslated .title-en { display: block; }

  .empty-state {
    display: none; text-align: center; padding: 48px 20px;
    background: var(--paper); border: 1px solid var(--rule); color: var(--ink-3); font-size: 14px;
  }
  .empty-state.show { display: block; }

  /* ===== Footer ===== */
  footer {
    margin-top: 36px; padding-top: 16px; border-top: 2px solid var(--rule-strong);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--ink-3);
  }
  footer a { color: var(--ink-2); text-decoration: none; }
  footer a:hover { color: var(--accent); text-decoration: underline; }

  @media (max-width: 820px) {
    .lead-grid { grid-template-columns: 1fr; }
    article.item { padding: 14px 16px; }
    .sec-head { padding: 11px 16px; }
    .time-pair { font-size: 11px; }
  }
</style>
</head>
<body>

<nav class="topbar" aria-label="版面切换">
  <div class="topbar-inner">
    <div class="edition-tabs">
      <span class="edition-label">近 {{ retention_days }} 天</span>
      {% for day in recent_days %}
      <a class="ed-tab{% if day.is_active %} active{% endif %}" href="{{ day.href }}">
        {% if day.is_today %}<span class="live-dot" title="今日滚动更新中"></span>{% endif %}{{ day.short_label }} <span class="cnt">{{ day.count }}</span>
      </a>
      {% endfor %}
    </div>
    <div class="topbar-right">
      <a class="archive-link" href="{{ root_prefix }}archive/index.html">历史归档 →</a>
      <button class="theme-btn" id="themeBtn" type="button">🌙 夜间版</button>
    </div>
  </div>
</nav>

<div class="container">

  {% if is_archived %}
  <div class="history-banner">
    <span>历史归档版面（<b>{{ page_date }}</b>）· 全量历史永久保留</span>
    <span><a href="{{ root_prefix }}archive/index.html">← 归档目录</a> · <a href="{{ root_prefix }}index.html">返回今日实时版 →</a></span>
  </div>
  {% elif not is_today %}
  <div class="history-banner">
    <span>您正在浏览 <b>{{ page_date }}</b> 版面 · 跨零点晚到新闻已按发布时间自动归入本页</span>
    <a href="{{ root_prefix }}index.html">返回今日实时版 →</a>
  </div>
  {% endif %}

  <header class="masthead">
    <div class="masthead-kicker">BLOOMBERG · REUTERS · WSJ</div>
    <h1>Market Dispatch</h1>
    <div class="dateline">
      <div class="dateline-left">
        <span><b>{{ cn_date }}</b> {{ weekday_cn }}</span>
        <span>时区 <span class="mono">{{ timezone }}</span></span>
        <span>按新闻发布时间归天</span>
      </div>
      <div class="dateline-right">
        <span>最近更新 <b class="mono">{{ updated_at_hm }}</b></span>
        <span>共 <b class="mono">{{ total_count }}</b> 条 · 要闻 <b class="mono">{{ important_count }}</b> 条</span>
        {% if batch_count > 0 %}
        <button class="batch-toggle {% if batch_fail_count > 0 %}bad{% else %}ok{% endif %}" id="batchToggle" type="button" aria-expanded="false">
          当日 {{ batch_count }} 批 · {% if batch_fail_count > 0 %}{{ batch_fail_count }} 次单源失败{% else %}全部正常{% endif %} ▾
        </button>
        {% endif %}
      </div>
    </div>
    {% if batch_count > 0 %}
    <div class="batch-drawer" id="batchDrawer">
      <div><b>当日抓取批次记录</b>（每小时自动运行，24h 回看防遗漏；单源异常不影响其他来源）：</div>
      <div class="batch-grid">
        {% for b in batches %}
        <span class="b-chip{% if not b.ok %} bad{% endif %}">{{ b.text }}</span>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </header>

  {% if important_items %}
  <section class="lead-section" id="leadSection" aria-label="今日要闻头条">
    <div class="lead-header">
      <h2>★ {% if is_today %}今日{% else %}当日{% endif %}要闻头条（{{ important_count }}）</h2>
      <span class="sub">三信号自动研判（标题特征词 / 跨源同事件 / GN 头条）{% if important_count > 6 %} · 头版精选前 6 条，下方可筛全部要闻{% else %} · 点击定位详情{% endif %}</span>
    </div>
    <div class="lead-grid">
      {% for item in important_items[:6] %}
      <div class="lead-card">
        <div>
          <div class="lead-meta">
            <span class="badge {{ item.source_cls }}">{{ item.source_label }}</span>
            <span class="lead-cat">{{ item.category_name }}</span>
            {% if item.important_reason %}<span class="lead-reason">{{ item.important_reason }}</span>{% endif %}
          </div>
          <a class="lead-title-zh" href="#item-{{ item.id }}">{{ item.title_zh or item.title_en }}</a>
          {% if item.title_zh %}<div class="lead-title-en">{{ item.title_en }}</div>{% endif %}
        </div>
        <div class="lead-foot">
          <span>发布 {{ item.pub_display }} · 抓取 {{ item.crt_display }}</span>
          <a href="{{ item.url_display }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="controls-wrap">
    <div class="cat-bar" id="catBar" role="tablist">
      <button class="cat-btn active" data-cat="all" type="button">全部栏目 <span class="n">{{ total_count }}</span></button>
      {% for sec in sections %}
      <button class="cat-btn" data-cat="{{ sec.key }}" type="button">{{ sec.icon }} {{ sec.name }} <span class="n">{{ sec.count }}</span></button>
      {% endfor %}
    </div>

    <div class="filter-bar">
      <div class="filter-group">
        <span class="fg-label">来源</span>
        <button class="pill-btn active" data-src="all" type="button">全部</button>
        <button class="pill-btn" data-src="bloomberg" type="button"><span class="src-dot dot-bbg"></span>彭博</button>
        <button class="pill-btn" data-src="reuters" type="button"><span class="src-dot dot-rtr"></span>路透</button>
        <button class="pill-btn" data-src="wsj" type="button"><span class="src-dot dot-wsj"></span>WSJ</button>

        <span class="fg-label" style="margin-left:6px">视图</span>
        <button class="pill-btn star-only" id="starOnlyBtn" type="button">★ 仅看要闻</button>
        <div class="seg-switch" role="group" aria-label="语言显示">
          <button class="active" data-lang="both" type="button">中英</button>
          <button data-lang="zh" type="button">仅中文</button>
        </div>
        <button class="pill-btn" id="toggleEnSumBtn" type="button">展开英文摘要</button>
      </div>

      <div class="status-right">
        <span id="visibleCount">显示 {{ total_count }} / {{ total_count }} 条</span>
        <button class="reset-link" id="resetBtn" type="button">重置筛选</button>
      </div>
    </div>
  </div>

  <main class="sections-list" id="sectionsList">
    {% if total_count == 0 %}
    <div class="empty-state show">
      当日暂无收录新闻元数据（等待下一次抓取批次自动更新）。
    </div>
    {% else %}
      {% for sec in sections %}
        {% if sec.count > 0 %}
        <section class="cat-sec" data-cat="{{ sec.key }}">
          <div class="sec-head">
            <div class="sec-title-wrap">
              <h3>{{ sec.icon }} {{ sec.name }}</h3>
              <span class="sec-en">{{ sec.en_name }}</span>
            </div>
            <div class="sec-meta">
              <span class="sec-count">{{ sec.count }} 条</span>
              <span class="sec-arrow">▾</span>
            </div>
          </div>
          <div class="sec-body">
            {% for item in sec.articles %}
            <article id="item-{{ item.id }}" class="item{% if item.is_important %} star{% endif %}{% if item.is_untranslated %} untranslated{% endif %}" data-source="{{ item.source }}" data-star="{% if item.is_important %}1{% else %}0{% endif %}">
              <div class="item-meta">
                <div class="meta-left">
                  <span class="badge {{ item.source_cls }}">{{ item.source_label }}</span>
                  {% if item.is_important %}
                  <span class="star-pill">★ 要闻</span>
                  {% if item.important_reason %}<span class="why-pill">{{ item.important_reason }}</span>{% endif %}
                  {% endif %}
                  {% if item.is_cross_day %}<span class="tag-cross">跨零点补入</span>{% endif %}
                  {% if item.is_untranslated %}<span class="tag-warn">未翻译</span>{% endif %}
                  {% if not item.summary_zh and not item.summary_en %}<span class="tag-muted">仅标题</span>{% endif %}
                </div>
                <div class="time-pair" title="新闻发布时间（published_at）与入库时间（created_at）">
                  <span class="t-pub">发布 <b>{{ item.pub_display }}</b></span>
                  <span class="t-sep">·</span>
                  <span class="t-crt">抓取 {{ item.crt_display }}</span>
                </div>
              </div>

              {% if not item.is_untranslated %}
              <a class="title-zh" href="{{ item.url_display }}" target="_blank" rel="noopener noreferrer">{{ item.title_zh }}<span class="ext">↗</span></a>
              <a class="title-en" href="{{ item.url_display }}" target="_blank" rel="noopener noreferrer">{{ item.title_en }}</a>
              {% else %}
              <a class="title-en" href="{{ item.url_display }}" target="_blank" rel="noopener noreferrer">{{ item.title_en }} ↗</a>
              {% endif %}

              {% if item.summary_zh %}
              <p class="sum-zh">{{ item.summary_zh }}</p>
              {% endif %}

              {% if item.summary_en %}
              <details class="en-sum"{% if item.is_untranslated %} open{% endif %}>
                <summary>{% if item.is_untranslated %}英文原摘要（翻译未完成自动展开）{% else %}英文原摘要{% endif %}</summary>
                <p>{{ item.summary_en }}</p>
              </details>
              {% endif %}
            </article>
            {% endfor %}
          </div>
        </section>
        {% endif %}
      {% endfor %}
      <div class="empty-state" id="emptyState">
        当前筛选条件下暂无匹配新闻，请尝试切换栏目、来源或关闭「仅看要闻」。
      </div>
    {% endif %}
  </main>

  <footer>
    <div>Market Dispatch（market-dispatch）· 仅采集公开 RSS 元数据，不保存正文 · 仅供个人学习研究</div>
    <div>
      {% if prev_link %}<a href="{{ prev_link.href }}">{{ prev_link.label }}</a>{% endif %}
      {% if prev_link and next_link %} · {% endif %}
      {% if next_link %}<a href="{{ next_link.href }}">{{ next_link.label }}</a>{% endif %}
      {% if not prev_link and not next_link %}<a href="{{ root_prefix }}index.html">今日日报</a> · <a href="{{ root_prefix }}archive/index.html">历史归档</a>{% endif %}
    </div>
  </footer>

</div>

<script>
(function () {
  const root = document.documentElement;
  const themeBtn = document.getElementById('themeBtn');
  function applyTheme(t) {
    root.setAttribute('data-theme', t);
    themeBtn.textContent = t === 'dark' ? '☀️ 日间版' : '🌙 夜间版';
    try { localStorage.setItem('md_theme', t); } catch (e) {}
  }
  const savedTheme = (() => { try { return localStorage.getItem('md_theme'); } catch (e) { return null; } })();
  if (savedTheme === 'dark') applyTheme('dark');
  themeBtn.addEventListener('click', () => {
    applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });

  const batchToggle = document.getElementById('batchToggle');
  const batchDrawer = document.getElementById('batchDrawer');
  if (batchToggle && batchDrawer) {
    batchToggle.addEventListener('click', () => {
      const open = batchDrawer.classList.toggle('open');
      batchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  document.querySelectorAll('.sec-head').forEach(head => {
    head.addEventListener('click', () => {
      const body = head.nextElementSibling;
      const arrow = head.querySelector('.sec-arrow');
      const collapsed = body.classList.toggle('collapsed');
      if (arrow) arrow.textContent = collapsed ? '▸' : '▾';
    });
  });

  const state = { cat: 'all', src: 'all', starOnly: false, enExpanded: false };
  const items = Array.from(document.querySelectorAll('article.item'));
  const sections = Array.from(document.querySelectorAll('section.cat-sec'));
  const visibleCountEl = document.getElementById('visibleCount');
  const emptyState = document.getElementById('emptyState');
  const resetBtn = document.getElementById('resetBtn');
  const leadSection = document.getElementById('leadSection');

  function applyFilters() {
    let shown = 0;
    sections.forEach(sec => {
      const secCat = sec.dataset.cat;
      const catMatch = state.cat === 'all' || state.cat === secCat;
      let secShown = 0;
      sec.querySelectorAll('article.item').forEach(item => {
        const srcMatch = state.src === 'all' || item.dataset.source === state.src;
        const starMatch = !state.starOnly || item.dataset.star === '1';
        const visible = catMatch && srcMatch && starMatch;
        item.style.display = visible ? '' : 'none';
        if (visible) { secShown++; shown++; }
      });
      sec.style.display = (catMatch && secShown > 0) ? '' : 'none';
    });

    const isFiltered = state.cat !== 'all' || state.src !== 'all' || state.starOnly;
    if (leadSection) leadSection.style.display = isFiltered ? 'none' : '';
    if (emptyState) emptyState.classList.toggle('show', items.length > 0 && shown === 0);
    if (resetBtn) resetBtn.classList.toggle('show', isFiltered);
    if (visibleCountEl) visibleCountEl.textContent = `显示 ${shown} / ${items.length} 条`;
  }

  document.querySelectorAll('#catBar .cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#catBar .cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.cat = btn.dataset.cat;
      applyFilters();
    });
  });

  document.querySelectorAll('[data-src]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-src]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.src = btn.dataset.src;
      applyFilters();
    });
  });

  const starOnlyBtn = document.getElementById('starOnlyBtn');
  if (starOnlyBtn) {
    starOnlyBtn.addEventListener('click', () => {
      state.starOnly = !state.starOnly;
      starOnlyBtn.classList.toggle('active', state.starOnly);
      applyFilters();
    });
  }

  document.querySelectorAll('.seg-switch button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.seg-switch button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.body.classList.toggle('zh-only', btn.dataset.lang === 'zh');
    });
  });

  const toggleEnSumBtn = document.getElementById('toggleEnSumBtn');
  if (toggleEnSumBtn) {
    toggleEnSumBtn.addEventListener('click', () => {
      state.enExpanded = !state.enExpanded;
      toggleEnSumBtn.classList.toggle('active', state.enExpanded);
      toggleEnSumBtn.textContent = state.enExpanded ? '收起英文摘要' : '展开英文摘要';
      document.querySelectorAll('details.en-sum').forEach(d => {
        if (d.closest('.untranslated')) return;
        d.open = state.enExpanded;
      });
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      state.cat = 'all'; state.src = 'all'; state.starOnly = false;
      document.querySelectorAll('#catBar .cat-btn').forEach(b => b.classList.toggle('active', b.dataset.cat === 'all'));
      document.querySelectorAll('[data-src]').forEach(b => b.classList.toggle('active', b.dataset.src === 'all'));
      if (starOnlyBtn) starOnlyBtn.classList.remove('active');
      applyFilters();
    });
  }
})();
</script>
</body>
</html>
